{
  "manifest_version": 3,
  "name": "Kikoe: Voice Answers for WaniKani & BunPro",
  "version": "0.9.1",
  "description": "Answer WaniKani and BunPro reviews and lessons with your voice using the Web Speech API",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png",
    "1024": "icons/icon1024.png"
  },
  "action": {
    "default_title": "Open Kikoe settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://www.wanikani.com/*",
    "https://api.wanikani.com/*",
    "https://bunpro.jp/*",
    "https://www.bunpro.jp/*"
  ],
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.wanikani.com/*",
        "https://bunpro.jp/*",
        "https://www.bunpro.jp/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "bundle.js",
        "data/jmdict.json",
        "data/kanjidic2.json"
      ],
      "matches": [
        "https://www.wanikani.com/*",
        "https://bunpro.jp/*",
        "https://www.bunpro.jp/*"
      ]
    }
  ]
}
