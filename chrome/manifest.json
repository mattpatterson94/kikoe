{
  "manifest_version": 3,
  "name": "Kikoe: Voice Answers for WaniKani & BunPro",
  "version": "0.6.0",
  "description": "Answer WaniKani and BunPro reviews and lessons with your voice using the Web Speech API",
  "options_page": "options.html",
  "host_permissions": [
    "https://www.wanikani.com/*",
    "https://api.wanikani.com/*",
    "https://bunpro.jp/*",
    "https://www.bunpro.jp/*"
  ],
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.wanikani.com/*",
        "https://bunpro.jp/*",
        "https://www.bunpro.jp/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "bundle.js",
        "data/jmdict.json",
        "data/kanjidic2.json"
      ],
      "matches": [
        "https://www.wanikani.com/*",
        "https://bunpro.jp/*",
        "https://www.bunpro.jp/*"
      ]
    }
  ]
}
