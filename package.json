{
  "name": "kikoe",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash build.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack:chrome": "mkdir -p dist && cd chrome && zip -r ../dist/kikoe-chrome.zip .",
    "pack:firefox": "mkdir -p dist && cd firefox && zip -r ../dist/kikoe-firefox.zip .",
    "pack:safari": "mkdir -p dist && cd safari && zip -r ../dist/kikoe-safari-web-extension.zip .",
    "pack": "npm run pack:chrome && npm run pack:firefox && npm run pack:safari",
    "safari:customize-app": "node scripts/customize-safari-app.js",
    "dev": "node dev.js",
    "dev:firefox": "node dev.js --firefox",
    "e2e:launch": "node tests/e2e/launch.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "readme:commands": "node scripts/readme-commands.js --write",
    "readme:commands:check": "node scripts/readme-commands.js"
  },
  "dependencies": {
    "kansuji": "^1.0.1",
    "to-words": "^3.7.0",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/chrome": "^0.2.2",
    "@types/dom-speech-recognition": "^0.0.12",
    "@vitest/coverage-v8": "^2.1.0",
    "esbuild": "^0.21.0",
    "eslint": "^9.39.4",
    "globals": "^17.7.0",
    "jsdom": "^25.0.0",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^2.1.0",
    "web-ext": "^10.4.0"
  }
}
