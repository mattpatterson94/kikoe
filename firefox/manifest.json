{
  "manifest_version": 2,
  "name": "Kikoe — Voice Answers for WaniKani & BunPro",
  "version": "0.6.0",
  "description": "Answer WaniKani and BunPro reviews and lessons with your voice, powered by the Web Speech API",
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "https://www.wanikani.com/*",
    "https://api.wanikani.com/*",
    "https://bunpro.jp/*",
    "https://www.bunpro.jp/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.wanikani.com/*",
        "https://bunpro.jp/*",
        "https://www.bunpro.jp/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    "injected.js",
    "bundle.js",
    "data/jmdict.json",
    "data/kanjidic2.json"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "kikoe@mattpatterson94.github.io",
      "strict_min_version": "109.0"
    }
  }
}
